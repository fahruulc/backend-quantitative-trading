# API Keys (Wajib Diisi)
GEMINI_API_KEY=
SECTORS_API_KEY=

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketdb

# App Config
APP_ENV=development # development, production
CACHE_EXPIRE_IN_SECONDS=3600 # 1 Jam

# Demo Mode (untuk testing tanpa consume tokens)
DEMO_MODE=false
USE_MOCK_DATA=false
